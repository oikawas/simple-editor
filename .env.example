# Registration token: entered once on each new device to register it, after
# which the device uses a token of its own. Generate with: openssl rand -hex 32
AUTH_TOKEN=change-me-to-a-long-random-string

# The server's LAN IP. Make it fixed (a DHCP reservation on the router):
# devices treat a different address as a different app.
SERVER_IP=192.168.1.10

# Optional local DNS names for the server, space-separated (e.g. notes.home.arpa).
# SERVER_NAMES=

# Optional
# BIND_ADDRESS=192.168.1.10
# HTTP_PORT=80
# HTTPS_PORT=443
# HISTORY_INTERVAL_MINUTES=10
# Failed sign-ins allowed per address within the window before a lockout
# AUTH_MAX_FAILURES=10
# AUTH_WINDOW_MINUTES=15
# AUTH_LOCKOUT_MINUTES=15
